# Solstice Hotel API Server Environment Variables

# Node environment: 'development' or 'production'
NODE_ENV=production

# Server listening port (required for local/container dev; ignored on Vercel Serverless Functions)
PORT=3000

# PostgreSQL connection string (Server-side secret, NEVER expose through VITE_*)
# Required for database queries. If omitted, database access fails fast with a clear error.
DATABASE_URL=postgresql://user:password@hostname:5432/solstice_hotel?sslmode=require

# Allowed origins for CORS (comma-separated list of origins)
# Example: https://solstice-hotel.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://solstice-hotel.vercel.app

# Alternative single frontend origin (checked alongside ALLOWED_ORIGINS)
FRONTEND_URL=https://solstice-hotel.vercel.app

# Optional custom regular expression for preview origins
# By default, origins matching https://solstice-hotel(-[a-zA-Z0-9_-]+)*.vercel.app are permitted.
# ALLOWED_ORIGIN_REGEX=^https:\/\/solstice-hotel(-[a-zA-Z0-9_-]+)*\.vercel\.app$

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
