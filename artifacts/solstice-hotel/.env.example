# Solstice Hotel Frontend Environment Variables

# Public base URL of the backend API server.
# When deploying to Vercel with separate projects for frontend and backend:
# Set this to the production URL of the api-server project.
# Example: https://solstice-hotel-api.vercel.app
#
# Do NOT append /api to the URL (the API client already prepends /api).
# If omitted or empty, relative /api/... calls are used (standard for local dev proxy).
VITE_API_BASE_URL=
